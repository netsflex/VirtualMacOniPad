#!/bin/sh
set -eu
export PATH=/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
# dpkg removes only this package's files. Virtual machine bundles in
# /var/mobile/Media/VirtualMac, the compiler work directory, caches and
# backups stay in place.
if test "${1:-}" = remove || test "${1:-}" = purge; then
    uicache -a 2>/dev/null || true
fi
exit 0
